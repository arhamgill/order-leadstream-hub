# =============================================================================
# LeadStream Hub — Environment Variables
# =============================================================================
# HOW TO USE THIS FILE:
#   1. Copy it to a new file named ".env"  (cp .env.example .env)
#   2. Fill in the real values on the right of each "=" sign.
#   3. NEVER commit the real ".env" file — it is gitignored on purpose.
#
# NOTE ON REPLIT:
#   On Replit you do NOT need this file. Replit injects the values from its
#   "Secrets" panel directly into the app. This file is a reference/checklist
#   of what to put in that panel, and is also usable for running locally.
#   (Local running currently needs a dotenv loader wired up — ask Claude.)
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — the app will NOT work without these
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase (your database) ---
# From: Supabase Dashboard → Project Settings → Data API / API keys
# NOTE: base URL only — do NOT append /rest/v1/
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (card payments) ---
# From: Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Admin dashboard login ---
# ADMIN_PASSWORD: the password you type to log into the admin panel.
# SESSION_SECRET: any long random string — used to sign login tokens.
ADMIN_PASSWORD=
SESSION_SECRET=

# --- Admin notification email ---
# Where new-order notification emails are sent. Also used as a fallback
# "business email" in settings. (Has a code default, but set your real one.)
ADMIN_EMAIL=

# --- Zelle payment display ---
# Shown to customers who choose Zelle at checkout.
ZELLE_NAME=
ZELLE_PHONE=


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — safe to leave blank; the app uses sensible defaults
# ─────────────────────────────────────────────────────────────────────────────

# "From" address on outgoing emails. Default: orders@leadstreamhub.com
FROM_EMAIL=

# Log verbosity: trace | debug | info | warn | error. Default: info
LOG_LEVEL=

# Environment mode: development | production. The dev script sets this for you.
NODE_ENV=


# ─────────────────────────────────────────────────────────────────────────────
# PLATFORM-PROVIDED — usually you do NOT set these yourself
# ─────────────────────────────────────────────────────────────────────────────

# Port the API server listens on. Replit sets this automatically.
# Only set it if running locally (e.g. 5000).
PORT=


# ─────────────────────────────────────────────────────────────────────────────
# NOT NEEDED RIGHT NOW — leave these commented out
# ─────────────────────────────────────────────────────────────────────────────

# DATABASE_URL — a direct Postgres connection string.
# The running app does NOT use this (it talks to Supabase via its API).
# It only matters for the unused Drizzle "db push" tooling. You can ignore it.
# DATABASE_URL=

# RESEND_API_KEY — a real Resend email API key.
# NOT used on Replit: email currently goes through Replit's Resend "connector".
# You would only need this if you move OFF Replit and switch email to a raw
# Resend API call. Leave commented until then.
# RESEND_API_KEY=
